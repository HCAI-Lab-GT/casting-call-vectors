# Hugging Face token (optional for public models, required for gated/private)
HF_TOKEN=

# Where to cache downloads (optional; defaults to HF defaults)
# HF_HOME=/home/you/.cache/huggingface
# TRANSFORMERS_CACHE=/home/you/.cache/huggingface/transformers

# Speed up downloads
HF_HUB_ENABLE_HF_TRANSFER=1

# Weights & Biases (observability)
WANDB_API_KEY=
WANDB_PROJECT=persona-vectors
WANDB_ENTITY=your-wandb-username-or-team
# Optional grouping for runs
# WANDB_RUN_GROUP=dev
