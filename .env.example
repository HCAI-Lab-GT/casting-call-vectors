# PACE Charge Account
PACE_ACCOUNT=

# LLM APIs (see README "Configuration and API keys")
# OpenRouter: gold-experiment judge + default CPU-phase answer generation
OPENROUTER_API_KEY=
# Together: CPU-phase pair-filtering judge (RoleJudge)
TOGETHER_API_KEY=
# Your own vLLM server (--backend vllm); always set this or pass --base_url
# VLLM_API_URL=http://host:port/v1

# Hugging Face token (optional for public models, required for gated/private)
HF_TOKEN=

# Where to cache downloads (optional; defaults to HF defaults)
# HF_HOME=/home/you/.cache/huggingface
# TRANSFORMERS_CACHE=/home/you/.cache/huggingface/transformers

# Speed up downloads
HF_HUB_ENABLE_HF_TRANSFER=1

# Weights & Biases (observability)
WANDB_API_KEY=
WANDB_PROJECT=persona-vectors
WANDB_ENTITY=your-wandb-username-or-team
# Optional grouping for runs
# WANDB_RUN_GROUP=dev

INSPECT_LOG_LEVEL=info