# Copy to .env and fill in only what the steps you run need.

# OpenRouter: CPU-phase answer generation and the GPT-4.1-mini judges
OPENROUTER_API_KEY=

# Together: CPU-phase pair-filtering judge (RoleJudge)
TOGETHER_API_KEY=

# Your own vLLM server, if you pass --backend vllm
# VLLM_API_URL=http://localhost:8000/v1

# Hugging Face token (optional for public models and the public dataset)
HF_TOKEN=
