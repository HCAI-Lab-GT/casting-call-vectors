import torch
from transformers import AutoModelForCausalLM, AutoTokenizer
from tqdm import tqdm
import sys

# --- CONFIGURATION FOR APPLE SILICON ---
MODEL_ID = "Qwen/Qwen2.5-1.5B-Instruct"
LAYER_ID = 14
OUTPUT_FILE = "analytical_vector_m4.pt"
GENERATE_LEN = 30 
BATCH_SIZE = 4   # Increase to 8 or 16 if you have 24GB+ RAM
DTYPE = torch.float16 

# Check for Apple Silicon availability
if not torch.backends.mps.is_available():
    print("❌ Error: MPS (Metal) not found. This script is optimized for Mac M-series chips.")
    sys.exit(1)
device = "mps"

# --- DATASET (Your Analytical Pairs) ---
# Paste your full JSON data here
data = {
    "positive_negative_pairs": [
        [
            "Your responses must be highly analytical: break down problems into logical components, use data and evidence, and provide clear step‑by‑step explanations.",
            "Do not use analytical reasoning; answer intuitively and rely on gut feelings rather than data or systematic breakdown."
        ],
        # ... Add the rest of your pairs
    ],
    "questions": [
        "How would you determine the most cost‑effective supplier for a component given price, lead time, and reliability data?",
        "Explain the steps you would take to diagnose why a web server is experiencing intermittent 500 errors.",
        # ... Add the rest of your 100 questions
    ]
}

def main():
    print(f"🚀 Loading {MODEL_ID} on Apple M4 (MPS)...")
    
    tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)
    tokenizer.pad_token = tokenizer.eos_token # Qwen needs this for batching
    
    # Load model directly onto the Metal device in float16
    model = AutoModelForCausalLM.from_pretrained(
        MODEL_ID, 
        torch_dtype=DTYPE, 
        device_map=device
    )
    
    # Initialize accumulators on the GPU to avoid CPU transfers
    pos_sum = torch.zeros(model.config.hidden_size, device=device, dtype=DTYPE)
    neg_sum = torch.zeros(model.config.hidden_size, device=device, dtype=DTYPE)
    total_samples = 0

    print(f"⚡ Extracting vectors from Layer {LAYER_ID}...")

    # --- THE FAST HOOK ---
    # Captures only the generated tokens (seq_len=1), ignoring the prompt
    current_batch_acts = []
    
    def hook_fn(module, input, output):
        # output[0] is [Batch, Seq_Len, Hidden]
        hidden_states = output[0].detach() # Keep on MPS, just detach gradients
        
        # We only capture if it is a generation step (1 token at a time)
        if hidden_states.shape[1] == 1: 
            current_batch_acts.append(hidden_states.squeeze(1)) 

    handle = model.model.layers[LAYER_ID].register_forward_hook(hook_fn)

    # --- BATCH PREPARATION ---
    tasks = []
    for q in data["questions"]:
        # Use the first prompt pair for all, or iterate if you have many
        pair = data["positive_negative_pairs"][0] 
        tasks.append((q, pair[0], pair[1]))
            
    # --- PROCESSING LOOP ---
    # tqdm will show you the speed (it/s)
    for i in tqdm(range(0, len(tasks), BATCH_SIZE), unit="batch"):
        batch = tasks[i : i + BATCH_SIZE]
        
        # 1. POSITIVE RUN
        prompts = [
            tokenizer.apply_chat_template([{"role":"system","content":p}, {"role":"user","content":q}], tokenize=False, add_generation_prompt=True)
            for (q, p, _) in batch
        ]
        
        # Tokenize and move to MPS
        inputs = tokenizer(prompts, return_tensors="pt", padding=True, padding_side="left").to(device)
        
        current_batch_acts = [] # Reset hook buffer
        model.generate(**inputs, max_new_tokens=GENERATE_LEN, min_new_tokens=GENERATE_LEN, use_cache=True)
        
        # Stack and Sum on GPU
        if current_batch_acts:
            stacked = torch.stack(current_batch_acts) # [Gen_Len, Batch, Hidden]
            mean_acts = stacked.mean(dim=0)           # [Batch, Hidden]
            pos_sum += mean_acts.sum(dim=0)           # Add to global accumulator
        
        # 2. NEGATIVE RUN
        prompts_neg = [
            tokenizer.apply_chat_template([{"role":"system","content":n}, {"role":"user","content":q}], tokenize=False, add_generation_prompt=True)
            for (q, _, n) in batch
        ]
        inputs_neg = tokenizer(prompts_neg, return_tensors="pt", padding=True, padding_side="left").to(device)
        
        current_batch_acts = []
        model.generate(**inputs_neg, max_new_tokens=GENERATE_LEN, min_new_tokens=GENERATE_LEN, use_cache=True)
        
        if current_batch_acts:
            stacked = torch.stack(current_batch_acts)
            mean_acts = stacked.mean(dim=0)
            neg_sum += mean_acts.sum(dim=0)

        total_samples += len(batch)
        
        # Optional: Clear MPS cache periodically if you crash (uncomment if needed)
        # torch.mps.empty_cache()

    handle.remove()

    # --- FINALIZE ---
    print("Computing difference and saving...")
    
    # Calculate Mean
    mean_pos = pos_sum / total_samples
    mean_neg = neg_sum / total_samples
    
    # Calculate Vector
    vec = mean_pos - mean_neg
    vec = vec / torch.norm(vec)
    
    torch.save(vec, OUTPUT_FILE)
    print(f"✅ Success! Optimized vector saved to {OUTPUT_FILE}")

if __name__ == "__main__":
    main()